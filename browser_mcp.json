{
    "mcpServers": {
      "playwright": {
        "command": "npx",
        "args": ["-y", "@playwright/mcp@latest"]
      },
      "airbnb": {
        "command": "npx",
        "args": ["-y", "@openbnb/mcp-server-airbnb"]
      },
      "duckduckgo-search": {
        "command": "uvx",
        "args": ["duckduckgo-mcp-server"]
      }
    }
  }